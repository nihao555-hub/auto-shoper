MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://grsai.dakka.com.cn/v1
TEXT_MODEL=gemini-3.1-flash-lite
IMAGE_PROVIDER=grsai
IMAGE_MODEL=gpt-image-2
CORS_ALLOW_ORIGIN_REGEX=^https://[a-z0-9-]+(?:\.[a-z0-9-]+)*\.(?:devinapps\.com|vercel\.app)$
DATABASE_BACKEND=sqlite
DATABASE_PATH=data/auto-shoper.db
OCEANBASE_HOST=
OCEANBASE_PORT=3306
OCEANBASE_USER=
OCEANBASE_PASSWORD=
OCEANBASE_DATABASE=
# 逗号分隔的一次性注册码；生产环境请使用随机高熵值
REGISTRATION_CODES=
SESSION_COOKIE_NAME=auto_shoper_session
SESSION_DAYS=30
# 独立随机密钥；设置后不要轮换或丢失，否则现有店铺 token 无法解密
TOKEN_ENCRYPTION_KEY=

ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_API_BASE_URL=https://openapi-api.alibaba.com/rest
ALIBABA_APPEND_OPERATION_TO_URL=false
ALIBABA_TIMEOUT_SECONDS=30
ALIBABA_OAUTH_AUTHORIZE_URL=https://openapi-auth.alibaba.com/oauth/authorize
# Token 交换走新版 GOP 网关 ALIBABA_API_BASE_URL 的 /auth/token/create，无需单独配置
ALIBABA_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/alibaba/oauth/callback
ALIBABA_OAUTH_SUCCESS_URL=http://127.0.0.1:5173/#/overview?alibaba=connected
ALIBABA_OAUTH_ERROR_URL=http://127.0.0.1:5173/#/overview?alibaba=error
